{
    "manifest_version": 3,
    "name": "Mark As Read",
    "version": "1.1.0",
    "minimum_chrome_version": "102",
    "description": "Mark a page as read by clicking on the extension icon.",
    "action": {
        "default_icon": "notvisited.png",
        "default_title": "Mark as read"
    },
    "background": {
        "service_worker": "background.js",
        "type": "module"
    },
    "commands": {
        "mark_page": {
            "suggested_key": {
                "default": "Ctrl+Shift+Z"
            },
            "description": "Mark/unmark the current page"
        }
    },
    "icons" : {
        "128": "icon_128.png",
        "48": "icon_48.png",
        "16": "icon_16.png"
    },
    "permissions": [
        "tabs",
        "storage",
        "unlimitedStorage"
    ],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    }
}
